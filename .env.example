# --- RAG retrieval options ---
# Set to 0 to disable the cross-encoder reranker (e.g. CPU-only machines).
ENABLE_RERANKER=1
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# # Local Model Config
MODEL_PATH=./pipeline-setup/models/phi3-traffic-lora
DEVICE=cuda

# --- LLM API Keys ---
# Used by the LangGraph agents (claim extraction, web research, synthesis).
GEMINI_API_KEY=

# Reserved for future web-search escalation. The current web tool uses
# DuckDuckGo, which needs no key. Leave blank unless/until Tavily is wired in.
TAVILY_API_KEY=

# --- Telegram ingestion worker (scripts/update_rag_telegram.py) ---
# Obtain API_ID / API_HASH from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=rag_updater_session

INGEST_POLL_SECONDS=60
INGEST_CHANNEL_LIMIT=20