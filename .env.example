# --- LLM / Agent API keys ---
GEMINI_API_KEY=your_gemini_api_key_here      # agentic orchestration (LangGraph agents)
TAVILY_API_KEY=your_tavily_api_key_here      # optional; only if you switch web search to Tavily

# --- Telegram MTProto (real-time OSINT ingestion) ---
# Create these at https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
# Optional: override the session file location
# TELEGRAM_SESSION_NAME=./scripts/rag_updater_session

# --- RAG retrieval options ---
# Set to 0 to disable the cross-encoder reranker (e.g. CPU-only machines).
ENABLE_RERANKER=1
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
